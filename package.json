{
  "name": "loki-cad-mcp",
  "version": "1.0.0",
  "description": "MCP server for CAD and 3D modelling — create, edit, export, and reason about 3D models",
  "author": "PRATHVI9607",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/PRATHVI9607/CAD_Autodesk_MCP.git"
  },
  "homepage": "https://github.com/PRATHVI9607/CAD_Autodesk_MCP#readme",
  "bugs": {
    "url": "https://github.com/PRATHVI9607/CAD_Autodesk_MCP/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "loki-cad-mcp": "./dist/index.js"
  },
  "files": [
    "dist/",
    "python/",
    "templates/",
    "scripts/",
    "models/exports/.gitkeep",
    "models/previews/.gitkeep",
    "logs/.gitkeep",
    "README.md",
    "USER_MANUAL.md",
    "claude_desktop_config_example.json"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "start:http": "node dist/http-server.js",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:http": "node tests/test-http-api.mjs",
    "test:all": "npm run build && start /B npm run start:http && timeout /t 3 && npm run test:http",
    "clean": "rimraf dist",
    "setup:python:win": "python -m venv .venv && .venv\\Scripts\\pip install -r python\\requirements.txt",
    "setup:python:unix": "python3 -m venv .venv && .venv/bin/pip install -r python/requirements.txt"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.9",
    "jest": "^29.7.0",
    "rimraf": "^5.0.7",
    "ts-jest": "^29.2.3",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  },
  "jest": {
    "preset": "ts-jest/presets/default-esm",
    "extensionsToTreatAsEsm": [".ts"],
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.ts",
      "**/src/**/*.test.ts"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "useESM": true
        }
      ]
    }
  }
}
